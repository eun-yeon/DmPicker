#include <winver.h>

1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION DMPICKER_VERSION
PRODUCTVERSION DMPICKER_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "eun-yeon"
            VALUE "FileDescription", "DM PICKER"
            VALUE "FileVersion", DMPICKER_VERSION_STRING
            VALUE "InternalName", "DmPicker"
            VALUE "LegalCopyright", "Copyright (C) 2026 eun-yeon"
            VALUE "OriginalFilename", "DmPicker.exe"
            VALUE "ProductName", "DM PICKER"
            VALUE "ProductVersion", DMPICKER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
